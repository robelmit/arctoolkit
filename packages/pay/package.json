{
  "name": "@arctoolkit/pay",
  "version": "0.1.0",
  "description": "Non-custodial USDC and EURC payments on Arc: invoices with a unique amount or a per-invoice address, payment links and QR codes, payment detection from the chain, and signed webhooks. The gateway never holds a key.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robelmit/arctoolkit.git",
    "directory": "packages/pay"
  },
  "homepage": "https://github.com/robelmit/arctoolkit/tree/main/packages/pay#readme",
  "bugs": {
    "url": "https://github.com/robelmit/arctoolkit/issues"
  },
  "keywords": [
    "arc",
    "circle",
    "usdc",
    "eurc",
    "payments",
    "checkout",
    "invoice",
    "non-custodial",
    "webhook"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@arctoolkit/evm": "workspace:^",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@scure/bip39": "^2.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
