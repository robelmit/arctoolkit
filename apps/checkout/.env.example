# Copy to .env and fill in. Never commit .env.

# mainnet or testnet
ARC_NETWORK=testnet

# Where the money goes. Set one or both:
#   RECEIVE_ADDRESS: one address; invoices are told apart by a small tag on the amount
#   RECEIVE_XPUB:    an extended PUBLIC key; each invoice gets its own address. Never an xprv.
RECEIVE_ADDRESS=
RECEIVE_XPUB=

# Merchant routes need this as "Authorization: Bearer <key>". At least 24 characters.
# One way to make one: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
API_KEY=

# Optional: where to POST signed events, and the secret to sign them with (at least 16 characters).
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional
# ARC_RPC_URL=https://rpc.testnet.arc.io
# PUBLIC_URL=https://pay.your-shop.example
# SHOP_NAME=Your Shop
# STORE_PATH=./data/checkout.json
# PORT=8790
# HOST=127.0.0.1
# TRUST_PROXY=1
# CROSS_CHAIN=0     hides "pay from another chain" (offered on address-mode USDC invoices)
